From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rui Figueira <rfigueira@cloudflare.com>
Date: Tue, 17 Nov 2026 15:55:48 +0000
Subject: [PATCH] Order a shadow root's sheets by tree position, not processing
 order

A <style> whose text changes is queued in pending_style_nodes, a HashSet,
and its sheet was appended to the shadow root's scoped set as it was
processed. When several sheets in one root were replaced in the same
resolve, the cascade followed hash order, so an earlier sheet could beat
a later one. Insert each sheet before the next registered sheet in the
shadow tree's pre-order, and append only when none follows.

Signed-off-by: Rui Figueira <rfigueira@cloudflare.com>
---
 src/document.rs | 53 +++++++++++++++++++++++++++++++++++++++++--------
 1 file changed, 45 insertions(+), 8 deletions(-)

diff --git a/src/document.rs b/src/document.rs
index 8aee2c2..a6a2350 100644
--- a/src/document.rs
+++ b/src/document.rs
@@ -1943,15 +1943,26 @@ impl BaseDocument {
         element.set_special_data(SpecialElementData::Stylesheet(stylesheet.clone()));

         if let Some(shadow_root_id) = shadow_scope {
-            // Appends arrive in tree order (process_added_subtree is a
-            // pre-order walk), which preserves document order per root.
+            // Pending <style> elements are processed in hash order, so place the
+            // sheet by tree order instead of appending it.
+            let before = self.next_scoped_stylesheet(shadow_root_id, node_id);
             if let NodeData::ShadowRoot(ref mut data) = self.nodes[shadow_root_id].data {
-                data.author_styles.stylesheets.append_stylesheet(
-                    None,
-                    &Default::default(),
-                    stylesheet,
-                    &self.guard.read(),
-                );
+                let guard = self.guard.read();
+                match before {
+                    Some(before) => data.author_styles.stylesheets.insert_stylesheet_before(
+                        None,
+                        &Default::default(),
+                        stylesheet,
+                        before,
+                        &guard,
+                    ),
+                    None => data.author_styles.stylesheets.append_stylesheet(
+                        None,
+                        &Default::default(),
+                        stylesheet,
+                        &guard,
+                    ),
+                }
             }
             self.note_shadow_style_change(shadow_root_id);
             return;
@@ -1978,6 +1989,32 @@ impl BaseDocument {
         }
     }

+    /// The sheet of the first node after `node_id`, in the shadow tree's
+    /// order, that has a sheet registered in that root's scoped set.
+    fn next_scoped_stylesheet(
+        &self,
+        shadow_root_id: NodeId,
+        node_id: NodeId,
+    ) -> Option<DocumentStyleSheet> {
+        let mut pending: Vec<NodeId> =
+            self.nodes.get(shadow_root_id)?.children().into_iter().rev().collect();
+        let mut after_node = false;
+        while let Some(id) = pending.pop() {
+            if after_node {
+                if let Some((sheet, Some(scope))) = self.nodes_to_stylesheet.get(&id) {
+                    if *scope == shadow_root_id {
+                        return Some(sheet.clone());
+                    }
+                }
+            }
+            after_node |= id == node_id;
+            if let Some(node) = self.nodes.get(id) {
+                pending.extend(node.children().into_iter().rev());
+            }
+        }
+        None
+    }
+
     /// Remove a sheet from a shadow root's scoped set (no-op when the
     /// sheet was never registered there).
     pub(crate) fn remove_shadow_stylesheet(
